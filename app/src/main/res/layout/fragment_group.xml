<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GroupFragment">

    <Button
        android:id="@+id/grJoin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/grCreate"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="14dp"
        android:background="@drawable/custom_group_join"
        android:textColor="@color/white"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:layout_marginBottom="16dp"
        android:text="@string/btn_gr_join" />

    <Button
        android:id="@+id/grCreate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="25dp"
        android:textColor="@color/white"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:background="@drawable/custom_group_create"
        android:text="@string/btn_gr_create" />

    <ExpandableListView
        android:id="@+id/simpleExpandableListView"
        android:layout_width="fill_parent"
        android:layout_height="518dp"/>
    
</RelativeLayout>